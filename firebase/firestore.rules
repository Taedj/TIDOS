rules_version = '2';

// TIDOS Firestore rules.
// admin/* holds the /TIDOSZIT control-password HASH (PBKDF2-SHA256, never the password).
// Only the owner's Google account may read or write it. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /admin/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.uid == "YTU4IuDy3SaGKOPt9E34iSge8Mo1";
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
