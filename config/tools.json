{
  "_doc": "TIDOS tool scout starter catalog. stacks: project stacks it applies to ([] = any); when_files: only if these globs match; detect: bin | module | npm_local | mcp; check: command TIDOS may suggest as an extra check once installed. TIDOS never runs 'install' itself.",
  "tools": [
    {"name": "gitleaks", "capability": "secret scanner", "stacks": [], "repo": "gitleaks/gitleaks",
     "detect": {"bin": "gitleaks"}, "version": ["gitleaks", "version"], "check": "gitleaks detect --no-banner --redact",
     "install": {"windows": "winget install --id Gitleaks.Gitleaks -e", "unix": "brew install gitleaks"},
     "why": "finds committed API keys and passwords before they are pushed"},
    {"name": "osv-scanner", "capability": "dependency vulnerability scanner", "stacks": ["python", "node/javascript", "flutter/dart", "go", "rust"],
     "repo": "google/osv-scanner", "detect": {"bin": "osv-scanner"}, "version": ["osv-scanner", "--version"],
     "check": "osv-scanner scan source -r .",
     "install": {"windows": "go install github.com/google/osv-scanner/v2/cmd/osv-scanner@latest", "unix": "brew install osv-scanner"},
     "why": "flags dependencies with known vulnerabilities (OSV database)"},
    {"name": "semgrep", "capability": "security static analysis", "stacks": ["python", "node/javascript", "go"],
     "repo": "semgrep/semgrep", "detect": {"bin": "semgrep"}, "version": ["semgrep", "--version"],
     "install": {"windows": "python -m pip install semgrep", "unix": "python3 -m pip install semgrep"},
     "why": "rule-based scan for injection, unsafe APIs and auth mistakes"},
    {"name": "ruff", "capability": "python linter", "stacks": ["python"], "repo": "astral-sh/ruff",
     "detect": {"bin": "ruff", "module": "ruff"}, "version": ["ruff", "--version"], "check": "ruff check .",
     "install": {"windows": "python -m pip install ruff", "unix": "python3 -m pip install ruff"},
     "why": "fast lint: unused imports, undefined names, common bugs"},
    {"name": "pyright", "capability": "python type checker", "stacks": ["python"], "repo": "microsoft/pyright",
     "detect": {"bin": "pyright"}, "version": ["pyright", "--version"],
     "install": {"windows": "npm install -g pyright", "unix": "npm install -g pyright"},
     "why": "catches wrong types and attribute errors without running the code"},
    {"name": "mypy", "capability": "python type checker", "stacks": ["python"], "repo": "python/mypy",
     "detect": {"bin": "mypy", "module": "mypy"}, "version": ["mypy", "--version"],
     "install": {"windows": "python -m pip install mypy", "unix": "python3 -m pip install mypy"},
     "why": "static type checking for annotated python"},
    {"name": "pytest", "capability": "python test runner", "stacks": ["python"], "repo": "pytest-dev/pytest",
     "detect": {"bin": "pytest", "module": "pytest"}, "version": ["python", "-m", "pytest", "--version"],
     "install": {"windows": "python -m pip install pytest", "unix": "python3 -m pip install pytest"},
     "why": "the standard way to write and run python checks"},
    {"name": "eslint", "capability": "javascript linter", "stacks": ["node/javascript"], "repo": "eslint/eslint",
     "detect": {"npm_local": "eslint", "bin": "eslint"}, "version": ["npx", "--no-install", "eslint", "--version"],
     "install": {"windows": "npm install --save-dev eslint", "unix": "npm install --save-dev eslint"},
     "why": "lint for JS/TS: undefined variables, unsafe patterns"},
    {"name": "playwright", "capability": "browser end-to-end tests", "stacks": ["node/javascript", "firebase"],
     "repo": "microsoft/playwright", "detect": {"npm_local": "playwright", "module": "playwright"},
     "version": ["npx", "--no-install", "playwright", "--version"],
     "install": {"windows": "npm install --save-dev @playwright/test", "unix": "npm install --save-dev @playwright/test"},
     "why": "proves web UI changes work in a real browser"},
    {"name": "shellcheck", "capability": "shell script linter", "stacks": [], "when_files": ["*.sh", "scripts/*.sh"],
     "repo": "koalaman/shellcheck", "detect": {"bin": "shellcheck"}, "version": ["shellcheck", "--version"],
     "check": "shellcheck scripts/*.sh",
     "install": {"windows": "winget install --id koalaman.shellcheck -e", "unix": "brew install shellcheck"},
     "why": "catches quoting and portability bugs in .sh scripts"},
    {"name": "ripgrep", "capability": "fast code search", "stacks": [], "repo": "BurntSushi/ripgrep",
     "detect": {"bin": "rg"}, "version": ["rg", "--version"],
     "install": {"windows": "winget install --id BurntSushi.ripgrep.MSVC -e", "unix": "brew install ripgrep"},
     "why": "fast search across large projects"},
    {"name": "ast-grep", "capability": "structural code search and rewrite", "stacks": [], "repo": "ast-grep/ast-grep",
     "detect": {"bin": "ast-grep"}, "version": ["ast-grep", "--version"],
     "install": {"windows": "npm install -g @ast-grep/cli", "unix": "npm install -g @ast-grep/cli"},
     "why": "search and refactor by syntax tree instead of regex"},
    {"name": "playwright-mcp", "capability": "browser control for agents (MCP)", "stacks": ["node/javascript", "firebase"],
     "repo": "microsoft/playwright-mcp", "detect": {"mcp": "playwright"},
     "install": {"windows": "claude mcp add playwright -- npx @playwright/mcp@latest", "unix": "claude mcp add playwright -- npx @playwright/mcp@latest"},
     "why": "lets the agent open the app and check the UI itself"},
    {"name": "context7", "capability": "up-to-date library docs for agents (MCP)", "stacks": [],
     "repo": "upstash/context7", "detect": {"mcp": "context7"},
     "install": {"windows": "claude mcp add context7 -- npx -y @upstash/context7-mcp", "unix": "claude mcp add context7 -- npx -y @upstash/context7-mcp"},
     "why": "current API docs instead of the model's memory: fewer invented APIs"},
    {"name": "github-mcp", "capability": "GitHub issues/PRs for agents (MCP)", "stacks": [],
     "repo": "github/github-mcp-server", "detect": {"mcp": "github"},
     "install": {"windows": "see https://github.com/github/github-mcp-server#installation", "unix": "see https://github.com/github/github-mcp-server#installation"},
     "why": "agents read issues and CI results directly"},
    {"name": "promptfoo", "capability": "LLM prompt evals", "stacks": [], "when_files": ["promptfooconfig.yaml"],
     "repo": "promptfoo/promptfoo", "detect": {"npm_local": "promptfoo"},
     "install": {"windows": "npx promptfoo@latest init", "unix": "npx promptfoo@latest init"},
     "why": "regression tests for prompts"}
  ]
}
