{
  "version": "1.0.2",
  "note": "Central DOM abstraction for chatgpt.com. Update ONLY this file when the ChatGPT UI changes. Never hardcode selectors elsewhere.",
  "page": {
    "url_patterns": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "logged_out_markers": ["Log in", "Sign up"],
    "captcha_markers": ["Verify you are human", "cf-challenge", "captcha",
      "Just a moment", "Verifying you are human", "Attention Required",
      "Checking your browser before you access"]
  },
  "composer": {
    "description": "Message input box (verified 2026-10-10: ProseMirror editor; data-testid hooks all dead)",
    "fallback_chain": [
      "div[contenteditable='true'].ProseMirror",
      ".ProseMirror",
      "[data-testid='composer-input']",
      "textarea[data-testid='prompt-textarea']",
      "div[contenteditable='true'][data-lexical-editor='true']",
      "textarea[placeholder*='Message']",
      "#prompt-textarea"
    ]
  },
  "send_button": {
    "description": "Send button for chatgpt.com (aria-label Send, testid, or last button in input container)",
    "fallback_chain": [
      "[data-testid='send-button']",
      "button[data-testid*='send']",
      "button[aria-label='Send prompt']",
      "button[aria-label='Send message']",
      "button[aria-label='Send']",
      "button[aria-label*='Send']",
      "form button[type='submit']",
      "form button:last-of-type"
    ]
  },
  "assistant_messages": {
    "description": "Assistant response bubbles, last = newest (verified 2026-10-11: modern ChatGPT uses article + markdown/prose containers + action buttons; user bubbles never match)",
    "fallback_chain": [
      "article:has(button[aria-label*='Copy']) .markdown",
      "article:has(button[aria-label*='Copier']) .markdown",
      "article:has(button[aria-label*='Copy'])",
      "article:has(button[aria-label*='Copier'])",
      "article div.markdown",
      "article [class*='markdown']",
      "div.markdown",
      "[class*='markdown']",
      ".markdown",
      "article .prose",
      "[data-message-author-role='assistant']",
      "div[data-message-author-role='assistant']",
      "div[data-testid*='conversation-turn']:has(button[aria-label*='Copy'])",
      "div[data-testid='conversation-turn-assistant']",
      ".markdown.prose"
    ]
  },
  "stop_button": {
    "description": "Visible while ChatGPT is generating; disappearance ~= completion (heuristic only; no hook 2026-10-10, completion falls back to text-stability)",
    "fallback_chain": [
      "[data-testid='stop-button']",
      "button[aria-label='Stop generating']",
      "button[aria-label='Stop streaming']",
      "button[aria-label*='Stop']",
      "button[data-testid*='stop']"
    ]
  },
  "new_chat": {
    "description": "New conversation control",
    "fallback_chain": [
      "a[href='/']",
      "[data-testid='create-new-chat-button']"
    ]
  },
  "completion": {
    "strategy": "stop-button-gone + message-count-stable + trailing-text-stable",
    "stable_polls_required": 3,
    "poll_interval_ms": 1500,
    "timeout_seconds_default": 180
  }
}
